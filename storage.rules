rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read: regulatory documents are served to the public.
    // Writes are restricted to the site owner only.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'chris@mmhfsp.co.za';
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
