# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls.
# Obtain your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="mmhfsp.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="mmhfsp"
VITE_FIREBASE_STORAGE_BUCKET="mmhfsp.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
